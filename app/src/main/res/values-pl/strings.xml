    <string name="google_services_soft_summary">Na urządzeniu bez usług Google Play niektóre funkcje mogą być ograniczone. microG zwykle je przywraca.</string>
    <string name="google_services_hard_title">Zależy od usług Google</string>
    <string name="google_services_hard_summary">Ta aplikacja zależy od komponentów Google, których nie zapewnia ani odgooglowane urządzenie, ani microG. Niektóre funkcje mogą w ogóle nie działać.</string>
