    <string name="google_services_soft_title">Usa serviços do Google</string>
    <string name="google_services_soft_summary">Em um dispositivo sem o Google Play Services, algumas funcionalidades podem ficar limitadas. O microG geralmente as restaura.</string>
    <string name="google_services_hard_title">Depende de serviços do Google</string>
    <string name="google_services_hard_summary">Este app depende de componentes do Google que nem um dispositivo desgooglizado nem o microG fornecem. Algumas funcionalidades podem não funcionar de jeito nenhum.</string>
    <string name="google_services_microg_full">Funciona com microG</string>
    <string name="google_services_microg_partial">Parcial com microG</string>
    <string name="google_services_microg_none">Não coberto pelo microG</string>
    <string name="gms_cap_push">Notificações push (FCM / GCM)</string>
    <string name="gms_cap_push_desc">Notificações enviadas pelo servidor (mensagens, alertas) podem atrasar ou não chegar sem o Google Play Services ou o microG. O app ainda abre e funciona com atualização manual.</string>
    <string name="gms_cap_activity">Reconhecimento de atividade / contador de passos</string>
    <string name="gms_cap_activity_desc">A detecção de atividade e passos passa pelo Play Services. Sem ele (o microG não oferece isso), essas funcionalidades de fitness não funcionam.</string>
    <string name="gms_cap_maps">Google Maps incorporado</string>
    <string name="gms_cap_maps_desc">Uma visualização incorporada do Google Maps pode ficar cinza ou em branco sem o Google Play Services. O microG cobre isso parcialmente.</string>
    <string name="gms_cap_billing">Compras e assinaturas do Google Play</string>
    <string name="gms_cap_billing_desc">Compras no app e assinaturas passam pela Play Store. Sem ela (o microG não a substitui), as compras falham. O app geralmente continua utilizável na versão gratuita.</string>
    <string name="gms_cap_licensing">Verificação de licença do Google Play (LVL)</string>
    <string name="gms_cap_licensing_desc">O app verifica sua licença com a Play Store. Sem ela, a verificação falha; dependendo do app, isso varia de um lembrete até a recusa em iniciar.</string>
    <string name="gms_cap_signin">Login do Google (token de autenticação antigo)</string>
    <string name="gms_cap_signin_desc">Fazer login com uma conta do Google usa um serviço do Google que fica ausente sem o Play Services. Geralmente é apenas uma entre várias opções de login.</string>
    <string name="gms_cap_maps_v1">Google Maps v1 (biblioteca de sistema antiga)</string>
    <string name="gms_cap_maps_v1_desc">Este app usa a antiga biblioteca Google Maps v1, ausente em dispositivos desgooglizados e não fornecida pelo microG (seus servidores foram desativados em 2013). As telas de mapa podem travar.</string>
    <string name="google_services_detection_caveat">Detectado a partir das permissões declaradas no manifesto do app. Uma compilação desgooglizada feita a partir de patches no código de um app pode manter uma permissão declarada mesmo depois de remover o que a usava, então uma linha aqui nem sempre significa que o recurso ainda esteja de fato acessível nesta compilação específica.</string>
    <string name="allow_unknown_sources">Permitir instalação de apps</string>
    <string name="allow_unknown_sources_DESC">O Omnify precisa de permissão para instalar apps. Permita agora para não ser interrompido na sua primeira instalação.\n\nDepois de ativar isso nas configurações, o Android fecha o Omnify para aplicar a mudança (principalmente na TV). Isso é normal: basta reabrir o app.</string>
