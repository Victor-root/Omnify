    <string name="google_services_soft_title">Usa servicios de Google</string>
    <string name="google_services_soft_summary">En un dispositivo sin Google Play Services, algunas funciones pueden verse limitadas. microG suele restablecerlas.</string>
    <string name="google_services_hard_title">Depende de servicios de Google</string>
    <string name="google_services_hard_summary">Esta app depende de componentes de Google que ni un dispositivo degoogleizado ni microG proporcionan. Algunas funciones pueden no funcionar en absoluto.</string>
    <string name="google_services_microg_full">Funciona con microG</string>
    <string name="google_services_microg_partial">Parcial con microG</string>
    <string name="google_services_microg_none">No cubierto por microG</string>
    <string name="gms_cap_push">Notificaciones push (FCM / GCM)</string>
    <string name="gms_cap_push_desc">Sin Google Play Services ni microG, las notificaciones enviadas por el servidor (mensajería, alertas) pueden retrasarse o no llegar. La app sigue abriéndose y funcionando con actualización manual.</string>
    <string name="gms_cap_activity">Reconocimiento de actividad / podómetro</string>
    <string name="gms_cap_activity_desc">La detección de actividad y de pasos pasa por Play Services. Sin él (microG no lo proporciona), estas funciones de actividad física no funcionan.</string>
    <string name="gms_cap_maps">Google Maps integrado</string>
    <string name="gms_cap_maps_desc">Una vista de Google Maps integrada puede quedarse gris o en blanco sin Google Play Services. microG la cubre parcialmente.</string>
    <string name="gms_cap_billing">Compras y suscripciones de Google Play</string>
    <string name="gms_cap_billing_desc">Las compras y suscripciones dentro de la app pasan por Play Store. Sin ella (microG no la sustituye), las compras fallan. La app suele seguir siendo utilizable en su versión gratuita.</string>
    <string name="gms_cap_licensing">Verificación de licencia de Google Play (LVL)</string>
    <string name="gms_cap_licensing_desc">La app verifica su licencia con Play Store. Sin ella la verificación falla; según la app, esto va desde un simple aviso hasta negarse a iniciarse.</string>
    <string name="gms_cap_signin">Inicio de sesión con Google (token de autenticación heredado)</string>
    <string name="gms_cap_signin_desc">Iniciar sesión con una cuenta de Google usa un servicio de Google que no está disponible sin Play Services. Suele ser solo una opción de inicio de sesión entre otras.</string>
    <string name="gms_cap_maps_v1">Google Maps v1 (biblioteca del sistema heredada)</string>
    <string name="gms_cap_maps_v1_desc">Esta app usa la antigua biblioteca Google Maps v1, ausente en dispositivos degoogleizados y no proporcionada por microG (sus servidores se cerraron en 2013). Las pantallas de mapas pueden fallar.</string>
    <string name="google_services_detection_caveat">Detectado a partir de los permisos declarados en el manifiesto de la app. Una versión degoogleizada creada parcheando el código de una app puede dejar declarado un permiso sin usar incluso después de eliminar lo que lo utilizaba, así que una fila aquí no siempre significa que esa función siga siendo realmente accesible en esta versión concreta.</string>
    <string name="allow_unknown_sources">Permitir instalar apps</string>
    <string name="allow_unknown_sources_DESC">Omnify necesita permiso para instalar apps. Concédelo ahora para que no te interrumpa en tu primera instalación.\n\nDespués de activarlo en los ajustes, Android cierra Omnify para aplicar el cambio (sobre todo en TV). Esto es normal: solo tienes que volver a abrir la app.</string>
