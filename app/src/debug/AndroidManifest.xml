<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>

        <!-- Debug-only testing aid: see ForceUpdatesNotificationReceiver's own doc comment. Exported
             so a plain adb command (a different app to Android, as far as component visibility goes)
             can reach it; only ever built into the debug variant, so this never ships. -->
        <receiver
            android:name="com.looker.droidify.receivers.ForceUpdatesNotificationReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="${applicationId}.FORCE_UPDATES_NOTIFICATION" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
